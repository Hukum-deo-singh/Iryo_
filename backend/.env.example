# Copy this file to .env and fill it in. Never commit .env.
# Load it in a terminal with:  set -a; source backend/.env; set +a

# Aiven PostgreSQL: Service Overview -> Connection information
DB_URL='jdbc:postgresql://PASTE_HOST_HERE:PASTE_PORT_HERE/PASTE_DATABASE_NAME_HERE?sslmode=require'
DB_USERNAME='PASTE_USER_HERE'
DB_PASSWORD='PASTE_PASSWORD_HERE'

# Signs login tokens. At least 32 characters. Make one with:  openssl rand -base64 48
JWT_SECRET='PASTE_RANDOM_SECRET_HERE'

# Lets you register devices. Make one with:  openssl rand -hex 24   (leave empty to disable)
ADMIN_API_KEY='PASTE_RANDOM_KEY_HERE'

# Optional
# DEVICE_ASSIGNMENT_MINUTES=2
# JWT_EXPIRY_MINUTES=720
# CORS_ALLOWED_ORIGINS=
